{
	"name": "@mct-dev/prs",
	"version": "0.1.0",
	"description": "Agent-assisted PR review in your terminal",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mct-dev/prs.git"
	},
	"bugs": {
		"url": "https://github.com/mct-dev/prs/issues"
	},
	"homepage": "https://github.com/mct-dev/prs#readme",
	"keywords": [
		"github",
		"pull-requests",
		"terminal",
		"tui",
		"bun"
	],
	"files": [
		"bin",
		"dist",
		"README.md",
		".env.example",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"bin": {
		"prs": "bin/prs.js"
	},
	"scripts": {
		"build:cli": "bun run dev/build-cli.ts",
		"build:npm-packages": "bun run dev/build-npm-packages.ts",
		"build:standalone": "bun run dev/build-standalone.ts",
		"dev": "PRS_FORCE_FULL_REPAINT_ON_START=1 PRS_MOTEL_PORT=${PRS_MOTEL_PORT:-27686} PRS_DEBUG_LOG=${PRS_DEBUG_LOG:-/tmp/prs-debug.log} bun --watch src/index.tsx",
		"dev:mock": "PRS_FORCE_FULL_REPAINT_ON_START=1 PRS_MOCK_PR_COUNT=200 PRS_MOCK_REPO_COUNT=4 bun --watch src/index.tsx",
		"start": "bun run src/index.tsx",
		"test": "bun test test",
		"test:keymap": "bun run --cwd=packages/keymap test",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --tsconfig tsconfig.json src/ test/",
		"format": "oxfmt src/ test/ dev/",
		"format:check": "oxfmt --check src/ test/ dev/",
		"package:smoke": "bun run dev/package-smoke.ts",
		"screenshots": "bun run dev/screenshots.ts",
		"demo": "bun run dev/demo.ts",
		"prepublishOnly": "printf '%s\n' 'Publish dist/npm/main, not the source checkout.' && exit 1",
		"prepack": "bun run build:cli"
	},
	"workspaces": [
		".",
		"packages/*"
	],
	"dependencies": {
		"@effect/atom-react": "4.0.0-beta.90",
		"@effect/sql-sqlite-bun": "4.0.0-beta.90",
		"@opentui/core": "0.4.2",
		"@opentui/react": "0.4.2",
		"effect": "4.0.0-beta.90",
		"marked": "17.0.1",
		"react": "19.2.7",
		"scheduler": "0.27.0"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@prs/keymap": "workspace:*",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.17",
		"oxfmt": "0.56.0",
		"oxlint": "1.71.0",
		"typescript": "6.0.3"
	}
}
